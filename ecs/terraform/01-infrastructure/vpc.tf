# ---------------------------------------------------------
# NETWORK
# A VPC is our own private network inside AWS. Everything else
# (database, load balancer, servers, containers) lives inside it.
# ---------------------------------------------------------
# The VPC. 10.20.0.0/16 means about 65,000 private IP addresses.
resource "aws_vpc" "main" {
  cidr_block           = "10.20.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "${var.project_name}-vpc"
  }
}

# A subnet is a slice of the VPC (/24 = 256 addresses) in one availability zone.
# We make two, in different zones, because the load balancer and the
# database subnet group both need at least two zones.
# "Public" means resources here can get a public IP address.
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.20.1.0/24"
  availability_zone       = "${var.aws_region}a"
  map_public_ip_on_launch = true

  tags = {
    Name = "${var.project_name}-public-a"
  }
}

# Second subnet, in a different availability zone (see above).
resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.20.2.0/24"
  availability_zone       = "${var.aws_region}b"
  map_public_ip_on_launch = true

  tags = {
    Name = "${var.project_name}-public-b"
  }
}

# The internet gateway is the VPC's door to the internet.
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.project_name}-igw"
  }
}

# A route table says where traffic goes. This rule sends all internet traffic
# (0.0.0.0/0) to the internet gateway. This is what makes the subnets "public".
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }
}

# Attach the route table to each subnet.
resource "aws_route_table_association" "public_a" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "public_b" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}
