# Copy this file to terraform.tfvars (in this folder) and fill it in.
#   cp terraform.tfvars.example terraform.tfvars
# Never commit terraform.tfvars, it contains passwords.

# ---------------------------------------------------------
# 1) Values from Stage 1
# ---------------------------------------------------------
# Run ./get-stage1-values.sh where you ran Stage 1, then paste its output
# over these lines.

vpc_id                = "REPLACE"   # the network the containers run in
public_subnet_a_id    = "REPLACE"   # subnet where containers start (zone a)
public_subnet_b_id    = "REPLACE"   # subnet where containers start (zone b)
ecs_security_group_id = "REPLACE"   # firewall attached to every container
tg_frontend_arn       = "REPLACE"   # ALB target group: frontend (port 80)
tg_grafana_arn        = "REPLACE"   # ALB target group: Grafana (port 3000)
tg_prometheus_arn     = "REPLACE"   # ALB target group: Prometheus (port 9090)
alb_dns_name          = "REPLACE"   # load balancer address (used for the URLs)
db_endpoint           = "REPLACE"   # database address (given to the containers)

# ---------------------------------------------------------
# 2) Your own values
# ---------------------------------------------------------

# Must be the same password as the database in Stage 1.
db_password = "Cloud123"

# Stripe test keys (used by the backend).
stripe_secret_key     = "REPLACE_WITH_STRIPE_TEST_SECRET_KEY"
stripe_webhook_secret = "REPLACE_WITH_STRIPE_WEBHOOK_SECRET"

# The password you will use to log in to Grafana (user: admin).
grafana_admin_password = "REPLACE_WITH_GRAFANA_PASSWORD"
